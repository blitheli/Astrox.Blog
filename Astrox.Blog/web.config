<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / AspNetCoreModuleV2：全部请求交给 ASP.NET Core（含 /resources 下载）。
  allowUnlisted=true 避免父级站点或全局 requestFiltering 拦截 .zip/.7z 等扩展名。
  发布时 SDK 会按需改写 aspNetCore 的 processPath / arguments。
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\Astrox.Blog.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <fileExtensions allowUnlisted="true">
            <remove fileExtension=".zip" />
            <remove fileExtension=".7z" />
            <remove fileExtension=".rar" />
            <remove fileExtension=".pdf" />
            <remove fileExtension=".json" />
            <remove fileExtension=".czml" />
            <remove fileExtension=".csv" />
            <remove fileExtension=".txt" />
            <remove fileExtension=".py" />
            <remove fileExtension=".cs" />
            <remove fileExtension=".hgt" />
            <remove fileExtension=".tif" />
            <remove fileExtension=".tiff" />
            <remove fileExtension=".glb" />
            <remove fileExtension=".bin" />
            <remove fileExtension=".dat" />
            <add fileExtension=".zip" allowed="true" />
            <add fileExtension=".7z" allowed="true" />
            <add fileExtension=".rar" allowed="true" />
            <add fileExtension=".pdf" allowed="true" />
            <add fileExtension=".json" allowed="true" />
            <add fileExtension=".czml" allowed="true" />
            <add fileExtension=".csv" allowed="true" />
            <add fileExtension=".txt" allowed="true" />
            <add fileExtension=".py" allowed="true" />
            <add fileExtension=".cs" allowed="true" />
            <add fileExtension=".hgt" allowed="true" />
            <add fileExtension=".tif" allowed="true" />
            <add fileExtension=".tiff" allowed="true" />
            <add fileExtension=".glb" allowed="true" />
            <add fileExtension=".bin" allowed="true" />
            <add fileExtension=".dat" allowed="true" />
          </fileExtensions>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
