@page "/Posts/{slug}"
@model Astrox.Blog.Pages.Posts.ViewModel
@using System.Text.Json
@inject Microsoft.Extensions.Options.IOptions<Astrox.Blog.Models.BlogOptions> BlogOptionsAccessor
@inject Astrox.Blog.Services.SiteUrlService SiteUrls
@{
    var blog = BlogOptionsAccessor.Value;
    ViewData["Title"] = Model.Post.Title;
    ViewData["Description"] = Model.Post.Summary ?? Model.Post.Title;
    ViewData["OgType"] = "article";
    ViewData["CanonicalPath"] = $"/Posts/{Model.Post.Slug}";
    if (!Model.Post.IsPublished)
        ViewData["Robots"] = "noindex, nofollow";

    var request = HttpContext.Request;
    var canonicalUrl = SiteUrls.Absolute(request, $"/Posts/{Model.Post.Slug}");
    var published = Model.Post.PublishedAt ?? Model.Post.CreatedAt;
    var modified = Model.Post.UpdatedAt;
    var jsonLd = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BlogPosting",
        ["headline"] = Model.Post.Title,
        ["description"] = Model.Post.Summary ?? Model.Post.Title,
        ["datePublished"] = published.ToUniversalTime().ToString("o"),
        ["dateModified"] = modified.ToUniversalTime().ToString("o"),
        ["author"] = new Dictionary<string, object?>
        {
            ["@type"] = "Person",
            ["name"] = blog.OwnerName
        },
        ["publisher"] = new Dictionary<string, object?>
        {
            ["@type"] = "Organization",
            ["name"] = blog.Title
        },
        ["mainEntityOfPage"] = new Dictionary<string, object?>
        {
            ["@type"] = "WebPage",
            ["@id"] = canonicalUrl
        },
        ["url"] = canonicalUrl,
        ["inLanguage"] = "zh-CN"
    };
    if (Model.Post.TagList.Any())
        jsonLd["keywords"] = string.Join(", ", Model.Post.TagList);

    var jsonLdText = JsonSerializer.Serialize(jsonLd);
}

@section HeadMeta {
    <meta property="article:published_time" content="@published.ToUniversalTime().ToString("o")" />
    <meta property="article:modified_time" content="@modified.ToUniversalTime().ToString("o")" />
    <meta property="article:author" content="@blog.OwnerName" />
    @foreach (var tag in Model.Post.TagList)
    {
        <meta property="article:tag" content="@tag" />
    }
    <script type="application/ld+json">@Html.Raw(jsonLdText)</script>
}

<article class="article">
    <header class="article-header">
        <a class="back-link" asp-page="/Index">← 返回列表</a>
        <h1>@Model.Post.Title</h1>
        <div class="article-meta">
            <time datetime="@published.ToString("o")">
                @published.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            </time>
            <span class="article-views">阅读 @Model.ViewCount.ToString("N0") 次</span>
            @if (!Model.Post.IsPublished)
            {
                <span class="badge draft">草稿</span>
            }
        </div>
        @if (Model.Post.TagList.Any())
        {
            <div class="post-tags">
                @foreach (var t in Model.Post.TagList)
                {
                    <a class="tag sm" asp-page="/Index" asp-route-tag="@t">@t</a>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Post.Summary))
        {
            <p class="article-summary">@Model.Post.Summary</p>
        }
    </header>
    <div class="markdown-body">
        @Html.Raw(Model.HtmlContent)
    </div>
</article>

@if (Model.Post.IsPublished)
{
    <section class="comments" id="comments" aria-label="评论">
        <h2 class="comments-title">评论</h2>
        <p class="muted comments-note">站内评论 · 提交后立即公开 · 无需审核</p>

        @if (!string.IsNullOrWhiteSpace(Model.CommentStatus))
        {
            <div class="flash" role="status">@Model.CommentStatus</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.CommentError))
        {
            <div class="flash flash-error" role="alert">@Model.CommentError</div>
        }

        <form method="post" asp-page-handler="Comment" class="comment-form form-stack" autocomplete="off">
            <input type="hidden" asp-for="Input.FormToken" />
            <div class="hp-field" aria-hidden="true">
                <label>
                    <span>网站</span>
                    <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
                </label>
            </div>
            <div class="comment-form-row">
                <label>
                    <span>昵称 <em>*</em></span>
                    <input asp-for="Input.AuthorName" maxlength="64" placeholder="怎么称呼你" />
                </label>
                <label>
                    <span>邮箱（可选，不公开）</span>
                    <input asp-for="Input.AuthorEmail" type="email" maxlength="200" placeholder="仅所有者可见" />
                </label>
            </div>
            <label>
                <span>评论 <em>*</em></span>
                <textarea asp-for="Input.Body" rows="4" maxlength="2000" placeholder="说点什么（纯文本，最多 2000 字）"></textarea>
            </label>
            <div class="btn-row">
                <button type="submit" class="btn primary">发表评论</button>
            </div>
            <p class="muted comment-hint">请勿灌水或刷屏；过快提交或频繁发言将被拒绝。</p>
        </form>

        @if (Model.Comments.Count == 0)
        {
            <p class="muted comments-empty">还没有评论，来写下第一条吧。</p>
        }
        else
        {
            <ol class="comment-list">
                @foreach (var c in Model.Comments)
                {
                    <li class="comment-item">
                        <header class="comment-meta">
                            <span class="comment-author">@c.AuthorName</span>
                            <time datetime="@c.CreatedAt.ToString("o")">
                                @c.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </time>
                            @if (Model.IsOwner)
                            {
                                <form method="post"
                                      asp-page-handler="DeleteComment"
                                      asp-route-commentId="@c.Id"
                                      class="comment-delete"
                                      onsubmit="return confirm('确认删除这条评论？');">
                                    <button type="submit" class="btn danger sm">删除</button>
                                </form>
                            }
                        </header>
                        <div class="comment-body">@c.Body</div>
                    </li>
                }
            </ol>
        }
    </section>
}
