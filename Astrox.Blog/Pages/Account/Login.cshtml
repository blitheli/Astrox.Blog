@page
@model Astrox.Blog.Pages.Account.LoginModel
@{
    ViewData["Title"] = "登录";
}

<section class="auth-panel">
    <h1>所有者登录</h1>
    <p class="muted">仅限博客所有者。不开放公开注册。</p>

    <form method="post" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="form-error"></div>
        <label>
            <span>邮箱</span>
            <input asp-for="Input.Email" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </label>
        <label>
            <span>密码</span>
            <input asp-for="Input.Password" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </label>
        <label class="checkbox">
            <input asp-for="Input.RememberMe" />
            <span>记住我</span>
        </label>
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <button type="submit" class="btn primary">进入控制台</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
